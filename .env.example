# Environment variables for temperature sensor
# Copy this file to .env and fill in your values

# MQTT Configuration
MQTT_SERVER=your-mqtt-broker.local
MQTT_PORT=1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_USE_TLS=true

# Sensor Configuration
SENSOR_PIN=4
SENSOR_READ_INTERVAL=300
SENSOR_METRIC_UNITS=true
SENSOR_MAX_RETRIES=3

# Optional: Override device hostname for testing
# HOSTNAME_OVERRIDE=raspberrypi-0w1
